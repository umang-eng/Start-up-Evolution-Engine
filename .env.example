# ============================================================
# Start-up Evolution Engine — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ---- Application ----
ENVIRONMENT=development            # development | staging | production
SERVICE_ROLE=api-gateway            # api-gateway | worker-engine (set per container)

# ---- Security (REQUIRED in production — use a strong 64-char random string) ----
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_64_CHAR_RANDOM_STRING

# ---- CORS (comma-separated list of allowed frontend origins) ----
ALLOWED_ORIGINS=http://localhost:3000

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=startup_evolution

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=           # Uncomment if Redis requires auth

# ---- Real-Time Search (at least one required for live market grounding) ----
# Option 1: Tavily (recommended — optimized for AI agents)
TAVILY_API_KEY=
# Option 2: Google Custom Search JSON API (100 free queries/day)
# GOOGLE_SEARCH_API_KEY=your_google_api_key_here
# GOOGLE_CSE_ID=your_custom_search_engine_id_here

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STREAM_URL=http://localhost:8000

# ---- Docker Port Overrides (optional) ----

# ---- Local Ollama inference ----
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:2b
# Optional; needed only when connecting to an authenticated remote Ollama server.
OLLAMA_API_KEY=
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=4096
OLLAMA_TIMEOUT_SECONDS=240
OLLAMA_KEEP_ALIVE=10m
PIPELINE_STAGE_RETRIES=1
# Fast mode skips optional web research and multi-agent calls, not model generation.
PIPELINE_FAST_MODE=true

# whisper.cpp HTTP server (POST /inference). FFmpeg must be installed on the API host.
WHISPER_HOST=http://localhost:8080
WHISPER_TIMEOUT_SECONDS=180
FFMPEG_BINARY=ffmpeg

# POSTGRES_EXTERNAL_PORT=5432
# REDIS_EXTERNAL_PORT=6379
# API_EXTERNAL_PORT=8000
# FRONTEND_EXTERNAL_PORT=3000
