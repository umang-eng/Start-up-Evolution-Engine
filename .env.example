# ============================================================
# Start-up Evolution Engine — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ---- Application ----
ENVIRONMENT=development            # development | staging | production

# ---- Security (REQUIRED in production — use a strong 64-char random string) ----
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_64_CHAR_RANDOM_STRING

# ---- CORS (comma-separated list of allowed frontend origins) ----
ALLOWED_ORIGINS=http://localhost:3000

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=startup_evolution

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=           # Uncomment if Redis requires auth

# ---- Gemini AI (REQUIRED) ----
GEMINI_API_KEY=your_gemini_api_key_here

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
